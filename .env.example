# Server-only DataImpulse proxy plan credentials from the Proxy Access panel.
# Copy this file to .env.local and fill in both values.
# Use the BASE login: do not append __cr or session parameters.
# These are NOT your account password or DataImpulse API key.
DATAIMPULSE_LOGIN=
DATAIMPULSE_PASSWORD=

# Optional developer API. Generate with: openssl rand -hex 32
CAPTURE_API_KEY=
